diff --git a/apps/keyboard-ios/PulpoKeyboardKit/Tests/KeyboardCoreTests/EmojiLocalizedSearchTests.swift b/apps/keyboard-ios/PulpoKeyboardKit/Tests/KeyboardCoreTests/EmojiLocalizedSearchTests.swift
