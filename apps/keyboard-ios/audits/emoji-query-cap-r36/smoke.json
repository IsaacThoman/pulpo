{
  "version": 1,
  "cases": [
    {
      "id": "all-ops-smoke",
      "family": "executor-interface-only",
      "initial": "  ",
      "expectedInitial": "",
      "actions": [
        {
          "op": "append",
          "value": "\tblue  sea\n",
          "expected": "blue sea "
        },
        {
          "op": "backspace",
          "expected": "blue sea"
        },
        {
          "op": "deleteWords",
          "count": 0,
          "expected": "blue sea"
        },
        {
          "op": "deleteWords",
          "count": 1,
          "expected": "blue"
        },
        {
          "op": "append",
          "value": "\n",
          "expected": "blue "
        },
        {
          "op": "append",
          "value": "👩‍🚀",
          "expected": "blue 👩‍🚀"
        },
        {
          "op": "backspace",
          "expected": "blue "
        },
        {
          "op": "deleteWords",
          "count": -1,
          "expected": "blue "
        },
        {
          "op": "deleteWords",
          "count": 2,
          "expected": ""
        },
        {
          "op": "clear",
          "expected": ""
        },
        {
          "op": "append",
          "value": "a",
          "expected": "a"
        },
        {
          "op": "append",
          "value": "́",
          "expected": "á"
        },
        {
          "op": "backspace",
          "expected": ""
        },
        {
          "op": "append",
          "value": " ́",
          "expected": ""
        },
        {
          "op": "append",
          "value": "x ",
          "expected": "x "
        },
        {
          "op": "append",
          "value": "́",
          "expected": "x ́"
        },
        {
          "op": "append",
          "value": "\t",
          "expected": "x ́ "
        },
        {
          "op": "deleteWords",
          "count": 1,
          "expected": ""
        }
      ]
    }
  ]
}
