PULPO_ENV_FILE=.env
NODE_ENV=development
PUBLIC_URL=http://localhost:8080
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=pulpo
POSTGRES_PASSWORD=pulpo
POSTGRES_DATABASE=pulpo
REDIS_URL=redis://redis:6379
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
COOKIE_SECURE=false
ALLOW_ANY_LOCALHOST_PORT=false
ALLOW_PRIVATE_PROVIDER_URLS=false
LOG_LEVEL=info
RESPONSE_EVENT_RETENTION_SECONDS=86400
RESPONSE_SNAPSHOT_INTERVAL_MS=1500

# Agent mode remains disabled until an administrator enables it. These values
# authenticate the worker to a separately deployed workspace controller.
# PULPO_INSTANCE_ID is optional on Coolify, where the preview FQDN supplies a
# stable per-deployment identity automatically.
WORKSPACE_CONTROLLER_URL=
WORKSPACE_CONTROLLER_TOKEN=
PULPO_INSTANCE_ID=

# Trusted Coolify previews may enable the built-in ci-preview bootstrap preset.
# The preset only runs for pulpo-pr-<number>.deathgrips.org and seeds once per
# fresh database. Keep every value empty for local and production deployments.
PULPO_BOOTSTRAP_PRESET=
PULPO_PREVIEW_ADMIN_EMAIL=
PULPO_PREVIEW_ADMIN_PASSWORD=
PULPO_PREVIEW_PROVIDER_API_KEY=
PULPO_PREVIEW_WORKSPACE_IMAGE_DIGEST=

STORAGE_DRIVER=s3
STORAGE_LOCAL_PATH=/app/data/objects
S3_ENDPOINT=http://seaweed-s3:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=pulpo
S3_ACCESS_KEY_ID=pulpo
S3_SECRET_ACCESS_KEY=replace-this-storage-secret
S3_FORCE_PATH_STYLE=true
S3_CONFIGURE_CORS=true

# Optional. Password resets can instead be issued by an administrator.
SMTP_URL=
SMTP_FROM=Pulpo <noreply@pulpo.local>
