{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pulpo:r37:executor-input:1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "cohort": {
      "enum": [
        "development",
        "smoke",
        "fresh"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "equivalences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "left": {
            "type": "string",
            "minLength": 1
          },
          "right": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "left",
          "right"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "cohort",
    "cases",
    "equivalences"
  ],
  "additionalProperties": false,
  "$defs": {
    "expect": {
      "type": "object",
      "properties": {
        "document": {
          "type": "string"
        },
        "caret": {
          "type": "integer",
          "minimum": 0
        },
        "selectionLength": {
          "type": "integer",
          "minimum": 0
        },
        "primitiveCount": {
          "type": "integer",
          "minimum": 0
        },
        "slotCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "personalCount": {
          "type": "integer",
          "minimum": 0
        },
        "personalDirty": {
          "type": "boolean"
        }
      },
      "required": [
        "document",
        "caret",
        "selectionLength",
        "primitiveCount"
      ],
      "additionalProperties": false
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "observe"
            },
            "expect": {
              "$ref": "#/$defs/expect"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "type"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "expect": {
              "$ref": "#/$defs/expect"
            }
          },
          "required": [
            "action",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "space"
            },
            "expect": {
              "$ref": "#/$defs/expect"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "return"
            },
            "expect": {
              "$ref": "#/$defs/expect"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "backspace"
            },
            "expect": {
              "$ref": "#/$defs/expect"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "setMode"
            },
            "mode": {
              "enum": [
                "en_US",
                "es",
                "en_es"
              ]
            },
            "expect": {
              "$ref": "#/$defs/expect"
            }
          },
          "required": [
            "action",
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "hostMove"
            },
            "caret": {
              "type": "integer",
              "minimum": 0
            },
            "selectionLength": {
              "type": "integer",
              "minimum": 0
            },
            "callback": {
              "type": "boolean"
            },
            "expect": {
              "$ref": "#/$defs/expect"
            }
          },
          "required": [
            "action",
            "caret",
            "selectionLength",
            "callback"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "hostReplace"
            },
            "document": {
              "type": "string"
            },
            "caret": {
              "type": "integer",
              "minimum": 0
            },
            "selectionLength": {
              "type": "integer",
              "minimum": 0
            },
            "callback": {
              "type": "boolean"
            },
            "newDocumentID": {
              "type": "boolean"
            },
            "expect": {
              "$ref": "#/$defs/expect"
            }
          },
          "required": [
            "action",
            "document",
            "caret",
            "selectionLength",
            "callback"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "setPolicy"
            },
            "policy": {
              "enum": [
                "normal",
                "private",
                "url",
                "numeric"
              ]
            },
            "predictions": {
              "type": "boolean"
            },
            "learnWords": {
              "type": "boolean"
            },
            "expect": {
              "$ref": "#/$defs/expect"
            }
          },
          "required": [
            "action",
            "policy",
            "predictions",
            "learnWords"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "acceptSlot"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "expect": {
              "$ref": "#/$defs/expect"
            }
          },
          "required": [
            "action",
            "index"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "replayCapturedSlot"
            },
            "capture": {
              "type": "integer",
              "minimum": 0
            },
            "expect": {
              "$ref": "#/$defs/expect"
            }
          },
          "required": [
            "action",
            "capture"
          ],
          "additionalProperties": false
        }
      ]
    },
    "case": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "familyId": {
          "type": "string",
          "minLength": 1
        },
        "contentLabel": {
          "enum": [
            "en",
            "es",
            "mixed",
            "control"
          ]
        },
        "prefix": {
          "type": "string"
        },
        "selected": {
          "type": "string"
        },
        "suffix": {
          "type": "string"
        },
        "route": {
          "enum": [
            "nextword",
            "completion",
            "control"
          ]
        },
        "typed": {
          "type": "string"
        },
        "acceptableByMode": {
          "type": "object",
          "properties": {
            "en_US": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 6,
              "uniqueItems": true
            },
            "es": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 6,
              "uniqueItems": true
            },
            "en_es": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 6,
              "uniqueItems": true
            }
          },
          "required": [
            "en_US",
            "es",
            "en_es"
          ],
          "additionalProperties": false
        },
        "oracle": {
          "enum": [
            "scored",
            "ambiguous",
            "control"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      },
      "required": [
        "id",
        "familyId",
        "contentLabel",
        "prefix",
        "selected",
        "suffix",
        "route",
        "typed",
        "acceptableByMode",
        "oracle",
        "rationale",
        "actions"
      ],
      "additionalProperties": false
    }
  }
}
