FROM node:22.23.4-alpine AS build
ARG NODE_ENV
ARG VITE_PULPO_PUBLIC_URL=https://pulpo.baby
WORKDIR /app
COPY package.json package-lock.json ./
COPY scripts/security/vendor/braces scripts/security/vendor/braces
COPY apps/search/package.json apps/search/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN npm ci --include=dev
COPY apps/search apps/search
COPY packages/contracts packages/contracts
COPY apps/web/src/lib/color.ts apps/web/src/lib/color-themes.ts apps/web/src/lib/
COPY apps/web/public/pulpo-smiley.png apps/web/public/pulpo-smiley.png
RUN npm run build -w @pulpo/contracts && npm run build -w @pulpo/search

FROM nginx:1.29-alpine
COPY deploy/nginx-search.conf /etc/nginx/conf.d/default.conf
COPY --chmod=755 deploy/start-web.sh /usr/local/bin/start-pulpo-web
COPY --from=build /app/apps/search/dist /usr/share/nginx/html
HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=6 CMD wget -q --spider http://127.0.0.1/ready || exit 1
CMD ["/usr/local/bin/start-pulpo-web"]
