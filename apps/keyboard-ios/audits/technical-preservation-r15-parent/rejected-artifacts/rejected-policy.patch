+  /// An explicit root distinguishes paths from prose such as `and/or`,
+  /// `Wait...really`, or an unspaced sentence. Bare filenames and relative
+  /// paths without a dot/root remain ambiguous and retain ordinary correction.
+  /// Derive this from the current cursor context so deleting the anchor or
+  /// moving out of the token immediately restores ordinary suggestions.
+  static func hasPathAnchor(_ token: Substring) -> Bool {
+    // A single leading slash can introduce an alternative in chat. Require
+    // a directory boundary before treating a Unix-rooted token as a path.
+    if token.hasPrefix("/") { return token.dropFirst().contains("/") }
+    if token.hasPrefix("./") || token.hasPrefix("../")
+      || token.hasPrefix("~/") || token.hasPrefix("\\\\") { return true }
+    var characters = token.makeIterator()
+    guard let drive = characters.next(), drive.isASCII, drive.isLetter,
+          characters.next() == ":", let separator = characters.next() else { return false }
+    return separator == "\\" || separator == "/"
   }
 
