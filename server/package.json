{
  "name": "@pulpo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.972.0",
    "@aws-sdk/s3-request-presigner": "^3.972.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@pulpo/contracts": "0.1.0",
    "@socket.io/redis-streams-adapter": "^0.3.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.58.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.4.0",
    "ioredis": "^5.7.0",
    "nodemailer": "^9.0.3",
    "openai": "^7.3.0",
    "postgres": "^3.4.7",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@types/nodemailer": "^6.4.17",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "~6.0.2",
    "vitest": "^3.2.4"
  }
}
