{
  "name": "pulpo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @pulpo/web",
    "dev:web": "npm run dev -w @pulpo/web",
    "dev:api": "npm run dev:api -w @pulpo/server",
    "dev:worker": "npm run dev:worker -w @pulpo/server",
    "dev:mobile": "npm run start -w @pulpo/mobile",
    "dev:desktop": "npm run dev -w @pulpo/desktop",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "deploy:iphone": "npm run --silent deploy:iphone -w @pulpo/mobile",
    "build": "npm run build -w @pulpo/contracts && npm run build -w @pulpo/client-core && npm run build -w @isaacthoman/pulpo && npm run build -w @pulpo/web && npm run build -w @pulpo/server && npm run typecheck -w @pulpo/mobile && npm run build -w @pulpo/desktop",
    "build:desktop": "npm run build -w @pulpo/contracts && npm run build -w @pulpo/client-core && npm run build -w @pulpo/desktop",
    "package:desktop": "npm run package -w @pulpo/desktop",
    "build:web": "npm run build -w @pulpo/contracts && npm run build -w @pulpo/client-core && npm run build -w @pulpo/web",
    "db:generate": "npm run db:generate -w @pulpo/server",
    "db:migrate": "npm run db:migrate -w @pulpo/server",
    "mobile:typecheck": "npm run typecheck -w @pulpo/mobile",
    "mobile:export": "npm run export -w @pulpo/mobile",
    "test": "npm run build -w @pulpo/contracts && npm run build -w @pulpo/client-core && npm run build -w @isaacthoman/pulpo && npm run test -w @semantic-release/npm && npm run test -w @pulpo/contracts && npm run test -w @pulpo/client-core && npm run test -w @isaacthoman/pulpo && npm run test -w @pulpo/web && npm run test -w @pulpo/workspace-controller && npm run test -w @pulpo/server && npm run test -w @pulpo/mobile && npm run test -w @pulpo/desktop",
    "lint": "oxlint --report-unused-disable-directives --deny-warnings",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "workspace-image:build": "docker build --file infra/workspace-image/Dockerfile --tag pulpo-agent-workspace:test .",
    "workspace-image:test": "docker run --rm --network=none pulpo-agent-workspace:test pulpo-workspace-smoke-test",
    "workspace-daemon:build": "npm run build -w @pulpo/workspace-daemon",
    "workspace-controller:build": "npm run build -w @pulpo/workspace-controller",
    "workspace-controller:image": "docker build --file infra/workspace-controller/Dockerfile --tag pulpo-workspace-controller:test .",
    "local:preview:init": "bash ./scripts/local-preview.sh init",
    "local:preview:refresh": "bash ./scripts/local-preview.sh refresh",
    "local:preview:reset": "bash ./scripts/local-preview.sh reset",
    "preview": "npm run preview -w @pulpo/web",
    "dev:android": "npm run android -w @pulpo/mobile"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "file:packages/semantic-release-npm",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "oxlint": "^1.71.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-worklets": "0.10.1",
    "semantic-release": "^25.0.8",
    "typescript": "~6.0.2",
    "vitepress": "1.6.4"
  },
  "overrides": {
    "expo-modules-core": "57.0.9",
    "linkify-it": "6.1.0",
    "markdown-it": "15.0.0",
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "nanoid": "3.3.18",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-worklets": "0.10.1",
    "vitepress@1.6.4": {
      "vite": "6.4.3"
    }
  }
}
