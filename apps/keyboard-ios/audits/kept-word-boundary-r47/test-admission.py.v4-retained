#!/usr/bin/env python3
"""Temporary SYNTHETIC fixtures only; never actual source/native PASS evidence."""
import copy
import gzip
import importlib.util
import io
import json
import os
import pathlib
import subprocess
import sys
import tarfile
import tempfile
import xml.etree.ElementTree as ET

HERE = pathlib.Path(__file__).resolve().parent
spec = importlib.util.spec_from_file_location('gate', HERE / 'freeze_gate.py')
g = importlib.util.module_from_spec(spec)
spec.loader.exec_module(g)
a = g.admission
spec = importlib.util.spec_from_file_location('controls', HERE / 'validate-source-controls.py')
controls = importlib.util.module_from_spec(spec)
spec.loader.exec_module(controls)
results = []
MODES = ([], ['-O'])  # Explicit: the outer interpreter's -O never propagates.
ENV = {**os.environ, 'PYTHONDONTWRITEBYTECODE': '1'}

with tempfile.TemporaryDirectory(prefix='SYNTHETIC-r47-admission-') as td:
    root = pathlib.Path(td)

    def put(name, value):
        path = root / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(value if isinstance(value, bytes) else json.dumps(value, allow_nan=False).encode())
        return path

    engine = g.CORE + 'Input/KeyboardEngine.swift'
    ordinary_test = a.PACKAGE + 'Tests/KeyboardCoreTests/OtherSyntheticTests.swift'
    hosted = g.TESTS[2]
    for name in [engine, ordinary_test, *g.TESTS, a.PACKAGE + 'Package.swift',
                 a.PACKAGE + 'Sources/KeyboardUI/Synthetic.swift', a.IOS + 'App/Synthetic.swift',
                 a.IOS + 'Extension/Synthetic.swift', a.IOS + 'project.yml', a.PROJECT]:
        put(name, b'SYNTHETIC SOURCE ONLY\n')
    for i in range(23):
        put(g.CORE + 'Synthetic' + str(i) + '.swift', b'SYNTHETIC CORE ONLY\n')
    for name in a.RESOURCE_NAMES:
        put(a.IOS + 'LanguageData/' + name, ('SYNTHETIC ' + name).encode())
    for name in g.required(root):
        if not (root / name).exists():
            put(name, b'SYNTHETIC AUDIT PLACEHOLDER ONLY\n')
    put(g.AUDIT + 'baseline-KeyboardEngine.swift.txt', b'SYNTHETIC BASELINE ONLY\n')
    core = a.hashes(root, {path for path in a.source_names(root, 'source-controls') if path.startswith(g.CORE)})
    pre = {**core, engine: g.sha(root / (g.AUDIT + 'baseline-KeyboardEngine.swift.txt'))}
    put(g.AUDIT + 'pre-edit-freeze.json', {'sources': pre})
    bins = {'baseline': '1' * 64, 'candidate': '2' * 64}
    res = a.resources(root)
    for variant in bins:
        source_hashes = {**core, 'Runner.swift': g.sha(root / (g.AUDIT + 'Runner.swift.txt'))}
        if variant == 'baseline':
            source_hashes[engine] = pre[engine]
        put(g.AUDIT + variant + '-final-build-receipt.json',
            {'exit': 0, 'binarySHA256': bins[variant], 'sourceHashes': source_hashes})

    suite = ET.Element('testsuite', tests='448', failures='0', errors='0', skipped='19', time='1.0')
    for name in sorted(controls.required):
        ET.SubElement(suite, 'testcase', classname='KeyboardCoreTests.ExternalTextTouchR47Tests', name=name, time='0.1')
    for i in range(432 + 19):
        case = ET.SubElement(suite, 'testcase', classname='SYNTHETIC.Other', name='synthetic-' + str(i), time='0')
        if i >= 432:
            ET.SubElement(case, 'skipped')
    # Existing validate_xml expects a container, as actual Swift Testing emits.
    container = ET.Element('testsuites')
    container.append(suite)
    xml = ET.tostring(container)
    put('SYNTHETIC/xml.gz', gzip.compress(xml, mtime=0))
    put('SYNTHETIC/test-binary.gz', gzip.compress(b'SYNTHETIC NONEXECUTABLE TEST BINARY', mtime=0))
    put('SYNTHETIC/host-binary', b'SYNTHETIC NONEXECUTABLE HOST BINARY')

    def desc(name):
        return a.descriptor(root, name, 'gzip' if name.endswith('.gz') else 'raw')

    def archive(name, source_hashes):
        buffer = io.BytesIO()
        with tarfile.open(fileobj=buffer, mode='w:') as tar:
            for path in source_hashes:
                data = (root / path).read_bytes()
                member = tarfile.TarInfo(path)
                member.size = len(data)
                tar.addfile(member, io.BytesIO(data))
        put(name, gzip.compress(buffer.getvalue(), mtime=0))

    ordinary_sources = a.sources(root, 'ordinary')
    native_sources = a.sources(root, 'native')
    archive('SYNTHETIC/ordinary-sources.tar.gz', ordinary_sources)
    archive('SYNTHETIC/native-sources.tar.gz', native_sources)
    ordinary_run = {'status': 'PASS', 'exit': 0, 'sources': ordinary_sources, 'sourcesAfter': ordinary_sources,
                    'resources': res, 'XMLSHA256': a.sha(xml),
                    'binarySHA256': a.decoded_digest(desc('SYNTHETIC/test-binary.gz'))}
    put('SYNTHETIC/ordinary-build-and-run.json', ordinary_run)
    ordinary_artifacts = {'xml': desc('SYNTHETIC/xml.gz'), 'testBinary': desc('SYNTHETIC/test-binary.gz'),
                          'run': desc('SYNTHETIC/ordinary-build-and-run.json'),
                          'build': desc('SYNTHETIC/ordinary-build-and-run.json'),
                          'sourceArchive': desc('SYNTHETIC/ordinary-sources.tar.gz')}
    attachments = []
    for lang in a.LANGUAGES:
        previous = 'good' if lang == 'en_US' else 'buena'
        for route in a.ROUTES:
            alternate = route.startswith('alternate-')
            word = 'café' if alternate else 'music' if lang == 'en_US' else 'mundo'
            samples = 3 if alternate else len(word)
            suffix = '.com' if route == 'url' else ' ' if route.endswith('space') else '🎉'
            offsets = [[0, 0] if route == 'url' else [0.1, 0.2] for _ in range(26)]
            row = {'language': lang, 'route': route, 'text': previous + ' ' + word + suffix,
                   'weight': 0 if route == 'url' else len(previous) + samples,
                   'count': 0 if route == 'url' else 1, 'offsets': offsets,
                   'previousCount': 0 if route == 'url' else 1, 'pair': 0 if route == 'url' else 1, 'alternate': alternate}
            attachments.append({'name': 'r47-' + lang + '-' + route, 'payload': row})
            if route != 'url':
                separator = ' ' if route.endswith('space') else '🎉🎉 '
                second = {'language': lang, 'route': route,
                          'text': previous + ' ' + word + separator + word + suffix,
                          'weight': row['weight'] + samples, 'wordCount': 2, 'offsets': offsets,
                          'previousCount': 1, 'pair': 1, 'selfPair': 1}
                attachments.append({'name': 'r47-second-' + lang + '-' + route, 'payload': second})
    put('SYNTHETIC/attachments.json', attachments)
    put('SYNTHETIC/summary.json', {'testResult': 'Passed', 'totalTestCount': 1, 'passedTests': 1, 'failedTests': 0, 'skippedTests': 0})
    put('SYNTHETIC/build.log', b'SYNTHETIC LOG HASH ONLY')
    put('SYNTHETIC/run.log.gz', gzip.compress(b'SYNTHETIC LOG HASH ONLY', mtime=0))
    native_build = {'status': 'PASS', 'exit': 0, 'sources': native_sources, 'sourcesAfter': native_sources,
                    'resources': res, 'builtResources': res,
                    'binaries': {'host': a.decoded_digest(desc('SYNTHETIC/host-binary')),
                                 'test': a.decoded_digest(desc('SYNTHETIC/test-binary.gz'))}}
    put('SYNTHETIC/native-build.json', native_build)
    native_run = {**native_build, 'buildSHA256': desc('SYNTHETIC/native-build.json')['sha256'],
                  'summarySHA256': desc('SYNTHETIC/summary.json')['sha256'],
                  'attachmentsSHA256': desc('SYNTHETIC/attachments.json')['sha256'],
                  'buildLogSHA256': desc('SYNTHETIC/build.log')['sha256'],
                  'logSHA256': desc('SYNTHETIC/run.log.gz')['sha256']}
    put('SYNTHETIC/native-run.json', native_run)
    native_artifacts = {key: desc(path) for key, path in {
        'summary': 'SYNTHETIC/summary.json', 'attachments': 'SYNTHETIC/attachments.json',
        'appBinary': 'SYNTHETIC/host-binary', 'testBinary': 'SYNTHETIC/test-binary.gz',
        'run': 'SYNTHETIC/native-run.json', 'build': 'SYNTHETIC/native-build.json',
        'sourceArchive': 'SYNTHETIC/native-sources.tar.gz',
        'buildLog': 'SYNTHETIC/build.log', 'runLog': 'SYNTHETIC/run.log.gz'}.items()}
    admissions = {kind: g.AUDIT + name for kind, name in g.ADMISSIONS.items()}
    for kind, path in admissions.items():
        put(path, a.produce(root, kind, native_artifacts if kind == 'native' else ordinary_artifacts))
    evidence = {name: g.AUDIT + 'SYNTHETIC-' + name + '.txt' for name in g.EVIDENCE}
    for path in evidence.values():
        put(path, b'SYNTHETIC PLACEHOLDER; NEVER AN ACTUAL REVIEW OR ADMISSION')
    input_path = put('SYNTHETIC/input.json', b'{"SYNTHETIC":true}')
    frozen_paths = {path.relative_to(root).as_posix() for path in root.rglob('*') if path.is_file()}
    freeze = {'version': 1, 'inputSHA256': g.sha(input_path), 'files': a.hashes(root, frozen_paths),
              'executables': bins, 'resources': res, 'evidence': evidence}
    original_files = {name: (root / name).read_bytes() for name in frozen_paths}
    original_freeze = copy.deepcopy(freeze)

    def restore():
        for name, data in original_files.items():
            put(name, data)
        return copy.deepcopy(original_freeze)

    def run_gate(f, expect_pass, label):
        put('gate-arguments.json', {'freeze': f, 'bins': bins, 'resources': res})
        code = "import importlib.util,json,pathlib,sys;s=importlib.util.spec_from_file_location('g',sys.argv[1]);g=importlib.util.module_from_spec(s);s.loader.exec_module(g);r=pathlib.Path(sys.argv[2]);d=json.loads((r/'gate-arguments.json').read_text());g.verify(d['freeze'],r/'SYNTHETIC/input.json',d['bins'],d['resources'],r)"
        for flags in MODES:
            result = subprocess.run([sys.executable, '-B', *flags, '-c', code, str(HERE / 'freeze_gate.py'), str(root)], capture_output=True, text=True, env=ENV)
            g.need((result.returncode == 0) == expect_pass, label + '/' + str(flags) + ': ' + result.stderr)

    run_gate(freeze, True, 'SYNTHETIC-good')

    def reject(label, mutate):
        f = restore()
        mutate(f)
        # Reseal current bytes, preserving omissions, so stale-evidence failures
        # cannot be explained merely by a changed file's outer freeze digest.
        for path in f['files']:
            if (root / path).is_file():
                f['files'][path] = g.sha(root / path)
        run_gate(f, False, label)
        results.append(label)

    def edit_json(path, change):
        data = a.load_json((root / path).read_bytes())
        change(data)
        put(path, data)

    reject('wrong-sealed-input-with-complete-files', lambda f: f.__setitem__('inputSHA256', '0' * 64))
    reject('empty-files', lambda f: f.__setitem__('files', {}))
    for label, path in [('evaluator', g.AUDIT + 'check.py'), ('source', engine),
                        ('build-receipt', g.AUDIT + 'candidate-final-build-receipt.json'),
                        ('admission-validator', g.AUDIT + 'admission.py')]:
        reject('omitted-' + label, lambda f, path=path: f['files'].pop(path))
    reject('wrong-final-resources', lambda f: f['resources'].__setitem__('es.pkdict', '0' * 64))
    reject('missing-review-role', lambda f: f['evidence'].pop('oracleReview'))
    reject('missing-review-file', lambda f: f['files'].pop(f['evidence']['oracleReview']))
    for label, path in [('focused-fixture', a.FOCUSED), ('support', a.SUPPORT), ('ordinary-test', ordinary_test),
                        ('native-hosted-test', hosted), ('generated-project', a.PROJECT),
                        ('package-manifest', a.PACKAGE + 'Package.swift')]:
        reject('stale-' + label, lambda f, path=path: put(path, b'SYNTHETIC CHANGED SOURCE'))
    for kind, path in admissions.items():
        reject(kind + '-resource-mismatch', lambda f, path=path: edit_json(path, lambda r: r['resources'].__setitem__('es.pkdict', '0' * 64)))
        reject(kind + '-extra-source', lambda f, path=path: edit_json(path, lambda r: r['sources'].__setitem__('SYNTHETIC/extra.swift', '0' * 64)))
        for status in (False, 0.0, 1):
            reject(kind + '-bad-exit-' + repr(status), lambda f, path=path, status=status: edit_json(path, lambda r: r.__setitem__('exit', status)))
        reject(kind + '-failed-status', lambda f, path=path: edit_json(path, lambda r: r.__setitem__('status', 'FAIL')))
        roles = native_artifacts if kind == 'native' else ordinary_artifacts
        for role in roles:
            reject(kind + '-missing-' + role, lambda f, path=path, role=role: edit_json(path, lambda r: r['artifacts'].pop(role)))
            reject(kind + '-wrong-' + role + '-digest', lambda f, path=path, role=role: edit_json(path, lambda r: r['artifacts'][role].__setitem__('sha256', '0' * 64)))
    reject('wrong-decoded-XML-digest', lambda f: edit_json(admissions['ordinary'], lambda r: r['artifacts']['xml'].__setitem__('decodedSHA256', '0' * 64)))
    reject('artifact-omitted-from-freeze', lambda f: f['files'].pop('SYNTHETIC/xml.gz'))
    reject('artifact-file-absent', lambda f: (root / 'SYNTHETIC/xml.gz').unlink())
    reject('artifact-path-escape', lambda f: edit_json(admissions['native'], lambda r: r['artifacts']['summary'].__setitem__('path', '../outside')))

    # Update both descriptor and outer freeze: reject actual bad provenance,
    # rather than stopping only at its stale descriptor hash.
    def provenance_mutation(kind, role, change):
        path = admissions[kind]
        record = a.load_json((root / path).read_bytes())
        artifact_path = record['artifacts'][role]['path']
        edit_json(artifact_path, change)
        record['artifacts'][role] = desc(artifact_path)
        if kind != 'native':
            record['artifacts']['build'] = record['artifacts']['run'] = desc(artifact_path)
        put(path, record)

    for label, change in [
        ('XML-mismatch', lambda r: r.__setitem__('XMLSHA256', '0' * 64)),
        ('binary-mismatch', lambda r: r.__setitem__('binarySHA256', '0' * 64)),
        ('source-after-mismatch', lambda r: r['sourcesAfter'].__setitem__(ordinary_test, '0' * 64)),
        ('resource-mismatch', lambda r: r['resources'].__setitem__('es.pkdict', '0' * 64)),
        ('boolean-exit', lambda r: r.__setitem__('exit', False)),
        ('unavailable', lambda r: r.__setitem__('unavailable', True))]:
        reject('ordinary-provenance-' + label, lambda f, change=change: provenance_mutation('ordinary', 'run', change))
    for label, change in [
        ('build-mismatch', lambda r: r.__setitem__('buildSHA256', '0' * 64)),
        ('binary-mismatch', lambda r: r['binaries'].__setitem__('test', '0' * 64)),
        ('built-resource-mismatch', lambda r: r['builtResources'].__setitem__('es.pkdict', '0' * 64)),
        ('summary-mismatch', lambda r: r.__setitem__('summarySHA256', '0' * 64)),
        ('attachment-mismatch', lambda r: r.__setitem__('attachmentsSHA256', '0' * 64)),
        ('build-log-mismatch', lambda r: r.__setitem__('buildLogSHA256', '0' * 64)),
        ('run-log-mismatch', lambda r: r.__setitem__('logSHA256', '0' * 64)),
        ('source-after-mismatch', lambda r: r['sourcesAfter'].__setitem__(hosted, '0' * 64))]:
        reject('native-provenance-' + label, lambda f, change=change: provenance_mutation('native', 'run', change))
    def stale_ordinary_archive(f):
        put(ordinary_test, b'SYNTHETIC CURRENT SOURCE; OLD ARCHIVE MUST FAIL')
        current = a.sources(root, 'ordinary')
        edit_json('SYNTHETIC/ordinary-build-and-run.json', lambda r: r.update(sources=current, sourcesAfter=current))
        for kind in ('source-controls', 'ordinary'):
            edit_json(admissions[kind], lambda r, kind=kind: r.update(sources=a.sources(root, kind)))
            edit_json(admissions[kind], lambda r: r['artifacts'].update(
                run=desc('SYNTHETIC/ordinary-build-and-run.json'), build=desc('SYNTHETIC/ordinary-build-and-run.json')))
    reject('ordinary-source-archive-stale-despite-resealed-source-and-receipts', stale_ordinary_archive)

    def stale_native_archive(f):
        put(hosted, b'SYNTHETIC CURRENT HOSTED TEST; OLD ARCHIVE MUST FAIL')
        current = a.sources(root, 'native')
        edit_json('SYNTHETIC/native-build.json', lambda r: r.update(sources=current, sourcesAfter=current))
        edit_json('SYNTHETIC/native-run.json', lambda r: r.update(sources=current, sourcesAfter=current,
                   buildSHA256=desc('SYNTHETIC/native-build.json')['sha256']))
        edit_json(admissions['native'], lambda r: r.update(sources=current))
        edit_json(admissions['native'], lambda r: r['artifacts'].update(
            run=desc('SYNTHETIC/native-run.json'), build=desc('SYNTHETIC/native-build.json')))
    reject('native-source-archive-stale-despite-resealed-source-and-receipts', stale_native_archive)

    # Structured native semantics, including full offset and second occurrence
    # checks, exercised directly in explicit normal/-O validator subprocesses.
    restore()
    native_code = "import importlib.util,pathlib,sys;s=importlib.util.spec_from_file_location('a',sys.argv[1]);a=importlib.util.module_from_spec(s);s.loader.exec_module(a);a.native_metrics(a.load_json(pathlib.Path(sys.argv[2]).read_bytes()),a.load_json(pathlib.Path(sys.argv[3]).read_bytes()))"
    def native_check(label, summary_change=None, attachment_change=None, good=False):
        summary = a.load_json(original_files['SYNTHETIC/summary.json'])
        rows = copy.deepcopy(attachments)
        if summary_change:
            summary_change(summary)
        if attachment_change:
            attachment_change(rows)
        put('native-summary-case.json', summary)
        put('native-attachments-case.json', rows)
        for flags in MODES:
            result = subprocess.run([sys.executable, '-B', *flags, '-c', native_code, str(HERE / 'admission.py'), str(root / 'native-summary-case.json'), str(root / 'native-attachments-case.json')], capture_output=True, text=True, env=ENV)
            g.need((result.returncode == 0) == good, 'native structured escaped: ' + label + result.stderr)
        if not good:
            results.append(label)
    native_check('SYNTHETIC-native-good', good=True)
    native_check('native-prose-summary-only', lambda r: (r.clear(), r.update(verdict='PASS')))
    native_check('native-skipped-test', lambda r: r.__setitem__('skippedTests', 1))
    native_check('native-boolean-passed-count', lambda r: r.__setitem__('passedTests', True))
    native_check('native-missing-attachment', attachment_change=lambda rows: rows.pop())
    native_check('native-first-offset-drift', attachment_change=lambda rows: next(r['payload'] for r in rows if r['name'] == 'r47-es-picker')['offsets'][25].__setitem__(1, .3))
    native_check('native-second-offset-drift', attachment_change=lambda rows: next(r['payload'] for r in rows if r['name'] == 'r47-second-es-picker')['offsets'][25].__setitem__(1, .3))
    native_check('native-second-weight-drift', attachment_change=lambda rows: next(r['payload'] for r in rows if r['name'] == 'r47-second-en_es-alternate-search').__setitem__('weight', 99))

    xml_code = "import importlib.util,pathlib,sys;s=importlib.util.spec_from_file_location('v',sys.argv[1]);v=importlib.util.module_from_spec(s);s.loader.exec_module(v);v.validate_xml(pathlib.Path(sys.argv[2]).read_bytes())"
    def xml_check(label, change=None):
        tree = ET.fromstring(xml)
        if change:
            change(tree)
        path = put('xml-case.xml', ET.tostring(tree))
        for flags in MODES:
            result = subprocess.run([sys.executable, '-B', *flags, '-c', xml_code, str(HERE / 'validate-source-controls.py'), str(path)], capture_output=True, text=True, env=ENV)
            g.need((result.returncode == 0) == (change is None), 'XML escaped: ' + label + result.stderr)
        if change:
            results.append(label)
    xml_check('SYNTHETIC-XML-good')
    xml_check('suite-level-error', lambda t: (t.find('testsuite').set('errors', '1'), ET.SubElement(t.find('testsuite'), 'error')))
    xml_check('nan-test-time', lambda t: t.find('.//testcase').set('time', 'NaN'))
    xml_check('inconsistent-suite-total', lambda t: t.find('testsuite').set('tests', '99'))
    xml_check('mandatory-skip', lambda t: ET.SubElement(t.find('.//testcase'), 'skipped'))
    xml_check('missing-mandatory-definition', lambda t: t.find('testsuite').remove(t.find('.//testcase')))

    # Producer CLI must accept retained descriptors without replacing old files.
    restore()
    put('SYNTHETIC/artifact-map.json', ordinary_artifacts)
    for i, flags in enumerate(MODES):
        output = root / ('SYNTHETIC-produced-' + str(i) + '.json')
        args = [sys.executable, '-B', *flags, str(HERE / 'admission.py'), '--root', str(root), 'produce', 'ordinary', str(root / 'SYNTHETIC/artifact-map.json'), str(output)]
        result = subprocess.run(args, capture_output=True, text=True, env=ENV)
        g.need(result.returncode == 0, 'producer failed: ' + result.stdout + result.stderr)
        retained = output.read_bytes()
        result = subprocess.run(args, capture_output=True, text=True, env=ENV)
        g.need(result.returncode != 0 and output.read_bytes() == retained, 'producer overwrote retained evidence')

print(json.dumps({'fixtureScope': 'SYNTHETIC ONLY; never actual admission evidence',
                  'syntheticFreezeGood': 'PASS', 'subprocessModes': ['normal', '-O'],
                  'rejectedCount': len(results), 'rejected': results}, sort_keys=True))
