{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R26 exact synthetic phrase suite v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "cases"],
  "properties": {
    "schema": {"const": 1},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["transcript", "spaced", "raw", "keys", "backspace", "space", "return", "hostMove", "hostReplace", "private", "nativeUndo"]},
        "text": {"type": "string"}, "offset": {"type": "integer", "minimum": 0},
        "selection": {"type": "integer", "minimum": 0}, "callback": {"type": "boolean"},
        "newIdentity": {"type": "boolean"},
        "expected": {"type": "string"}, "caret": {"type": "integer", "minimum": 0},
        "phantom": {"type": "boolean"}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "contentLabel", "category", "prefix", "selected", "suffix", "actions", "expected", "caret"],
      "properties": {
        "id": {"type": "string"}, "contentLabel": {"enum": ["en", "es", "mixed", "opaque", "control"]},
        "category": {"type": "string"}, "prefix": {"type": "string"}, "selected": {"type": "string"}, "suffix": {"type": "string"},
        "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/action"}},
        "expected": {"type": "string"}, "caret": {"type": "integer", "minimum": 0},
        "context": {"enum": ["full", "fresh", "hidden-before", "hidden-after", "hidden-both", "own-lag", "queued", "reentrant"]},
        "field": {"enum": ["normal", "private", "url", "numeric"]},
        "capitalization": {"enum": ["none", "sentences"]},
        "smartPunctuation": {"type": "boolean"}, "smartQuotes": {"type": "boolean"},
        "route": {"enum": ["engine", "controller"]},
        "oracle": {"enum": ["exact", "ambiguous"]}, "rationale": {"type": "string"}
      }
    }
  }
}
