NODE_ENV=development
PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgres://pulpo:pulpo@postgres:5432/pulpo
REDIS_URL=redis://redis:6379
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_EMAIL=admin@pulpo.local
BOOTSTRAP_ADMIN_PASSWORD=replace-this-password
BOOTSTRAP_ADMIN_NAME=Pulpo Admin

STORAGE_DRIVER=s3
S3_ENDPOINT=http://seaweed-s3:8333
S3_REGION=us-east-1
S3_BUCKET=pulpo
S3_ACCESS_KEY_ID=pulpo
S3_SECRET_ACCESS_KEY=replace-this-storage-secret
S3_FORCE_PATH_STYLE=true

# Optional. Password resets can instead be issued by an administrator.
SMTP_URL=
SMTP_FROM=Pulpo <noreply@pulpo.local>
