# Generated values are written to .env.selfhost by scripts/self-host-init.sh.
PULPO_IMAGE_TAG=source
PULPO_BIND_ADDRESS=127.0.0.1
PULPO_HTTP_PORT=8080
PULPO_CLIENT_MAX_BODY_SIZE=25m

NODE_ENV=production
PUBLIC_URL=http://localhost:8080
INSTANCE_NAME=Pulpo
PULPO_VERSION=source

POSTGRES_USER=pulpo
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=pulpo
ENCRYPTION_KEY=change-me
REDIS_URL=redis://redis:6379

SESSION_COOKIE_NAME=pulpo_session
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
ALLOW_ANY_LOCALHOST_PORT=false
ALLOW_PRIVATE_PROVIDER_URLS=false
LOG_LEVEL=info
RESPONSE_EVENT_RETENTION_SECONDS=86400
RESPONSE_SNAPSHOT_INTERVAL_MS=1500

# The single-host default stores attachments in the shared object_data volume.
# See docs/self-hosting.md before switching to an external S3-compatible store.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/data/objects

PULPO_BILLING_ENABLED=false

# Optional. Without SMTP, an administrator must handle password recovery.
SMTP_URL=
SMTP_FROM=Pulpo <noreply@pulpo.local>
