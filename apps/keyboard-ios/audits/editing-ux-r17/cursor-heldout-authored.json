{
  "schema_version": 1,
  "suite": "pulpo-keyboard-pr782-r17-independent-cursor-heldout",
  "operation_order": [
    "move_by_character_offset",
    "insert_literal_text"
  ],
  "contract": {
    "selection_units": "UTF-16 code units; NSRange location and length",
    "movement_units": "Unicode extended grapheme clusters",
    "caret_movement": "Move the caret by the signed offset, clamping at the document start or end on overshoot.",
    "zero_movement": "A zero movement offset preserves the existing selection.",
    "insertion": "Replace the current selection with the exact literal text and collapse the selection immediately after the inserted text.",
    "normalization": "Preserve exact Unicode code point sequences; do not normalize."
  },
  "limitations": [
    "Synthetic independently authored oracle cases only; no implementation, development tests, prior audits, or sealed cases were inspected.",
    "No simulator, device, native test, build, deployment, or product execution was used.",
    "Overshoot clamping and zero-offset selection preservation are explicit oracle assumptions, not observations of the adapter.",
    "Nonempty selections use zero movement only; movement from a nonempty selection is not specified or covered.",
    "Does not cover ranking, correction, marked-text lifecycle, keyboard event delivery, or platform-specific Unicode segmentation differences."
  ],
  "cases": [
    {
      "id": "r17-cursor-01",
      "language": "English",
      "document": "Bring tea.",
      "starting_selection": {
        "location": 6,
        "length": 0
      },
      "character_offset": 3,
      "inserted_text": " today",
      "expected_document": "Bring tea today.",
      "expected_selection": {
        "location": 15,
        "length": 0
      }
    },
    {
      "id": "r17-cursor-02",
      "language": "English",
      "document": "Send the draft.",
      "starting_selection": {
        "location": 9,
        "length": 5
      },
      "character_offset": 0,
      "inserted_text": "notes",
      "expected_document": "Send the notes.",
      "expected_selection": {
        "location": 14,
        "length": 0
      }
    },
    {
      "id": "r17-cursor-03",
      "language": "Spanish",
      "document": "Cafe\u0301 con pan.",
      "starting_selection": {
        "location": 0,
        "length": 0
      },
      "character_offset": 4,
      "inserted_text": " caliente",
      "expected_document": "Cafe\u0301 caliente con pan.",
      "expected_selection": {
        "location": 14,
        "length": 0
      }
    },
    {
      "id": "r17-cursor-04",
      "language": "Spanish",
      "document": "Si\u0301, man\u0303ana!",
      "starting_selection": {
        "location": 3,
        "length": 0
      },
      "character_offset": -20,
      "inserted_text": "\u00a1",
      "expected_document": "\u00a1Si\u0301, man\u0303ana!",
      "expected_selection": {
        "location": 1,
        "length": 0
      }
    },
    {
      "id": "r17-cursor-05",
      "language": "Spanish-English bilingual",
      "document": "Hola \ud83d\udc69\ud83c\udffd\u200d\ud83d\udcbb \u2014 hi!",
      "starting_selection": {
        "location": 5,
        "length": 0
      },
      "character_offset": 1,
      "inserted_text": ", amiga",
      "expected_document": "Hola \ud83d\udc69\ud83c\udffd\u200d\ud83d\udcbb, amiga \u2014 hi!",
      "expected_selection": {
        "location": 19,
        "length": 0
      }
    },
    {
      "id": "r17-cursor-06",
      "language": "Spanish-English bilingual",
      "document": "Listo \u2014 let's go \ud83c\uddea\ud83c\uddf8!",
      "starting_selection": {
        "location": 8,
        "length": 0
      },
      "character_offset": 99,
      "inserted_text": " \ud83d\ude80",
      "expected_document": "Listo \u2014 let's go \ud83c\uddea\ud83c\uddf8! \ud83d\ude80",
      "expected_selection": {
        "location": 25,
        "length": 0
      }
    }
  ]
}
