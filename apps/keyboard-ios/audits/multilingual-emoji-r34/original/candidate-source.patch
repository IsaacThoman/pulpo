+def add_spanish_emoji_names(catalog, paths):
+  """Join CLDR Spanish speech names only, preserving all legacy catalog fields.
+
+  Both base and derived annotations may be supplied. Keywords do not enter the
+  English index. VS16 is presentation, not a different catalog sequence.
+  """
+  names = {}
+  for path in paths:
+    root = ET.parse(path).getroot()
+    identity = root.find('./identity/language')
+    if identity is None or identity.get('type') != 'es':
+      raise ValueError(f'Expected Spanish CLDR annotations: {path}')
+    for annotation in root.findall('./annotations/annotation'):
+      if annotation.get('type') != 'tts':
+        continue
+      sequence = annotation.get('cp', '').replace('\ufe0f', '')
+      name = (annotation.text or '').strip()
+      if not sequence or not name or name in {'↑↑↑', '∅∅∅'}:
+        continue
+      if sequence in names and names[sequence] != name:
+        raise ValueError(f'Conflicting Spanish CLDR speech names for {sequence}')
+      names[sequence] = name
+  for category in catalog['categories']:
+    for emoji in category['emoji']:
+      name = names.get(emoji['e'].replace('\ufe0f', ''))
+      if name:
+        emoji['s'] = name
+      else:
+        emoji.pop('s', None)
+  return catalog
+
