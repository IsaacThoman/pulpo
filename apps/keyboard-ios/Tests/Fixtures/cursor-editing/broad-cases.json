{
  "schema_version": 1,
  "suite": "Pulpo PR782 R17 multilingual editing UX independent held-out synthetic cases",
  "case_count": 6,
  "seal_policy": "Reveal only after candidate source review and freeze; do not include case contents in implementer messages.",
  "selection_contract": {
    "unit": "UTF-16 code units",
    "range": "zero-based, half-open, normalized start/end; collapsed range is a caret",
    "line_endings": "LF",
    "unicode_normalization": "literal precomposed characters as serialized; no automatic normalization",
    "unfocused_selection": "stored editor range; highlight hidden while editor is unfocused",
    "shift_selection_anchor": "original caret remains the anchor across consecutive Shift+ArrowLeft actions"
  },
  "fixture_and_action_contract": [
    "Each case starts independently with the exact document, selection, languages and UI state specified; install them as fixture state without typing setup text.",
    "Try It means the editable demonstration document, including its onboarding instance where specified.",
    "Typing replaces the selection or inserts at the caret. Exact literal input is supplied with composition completed; no suggestions, autocorrection, smart punctuation or ranking are accepted.",
    "select_range denotes ordinary text selection via available editor controls. move_caret denotes an ordinary beginning/end navigation command. Key actions are logical keyboard events.",
    "Onboarding next/back and settings actions bind to the matching semantic controls; no particular visible label, screen layout or implementation API is assumed.",
    "The settings case assumes an active typing-language setting for the already-enabled English and Spanish languages. App UI locale remains English; choosing a typing language does not imply translating the app interface.",
    "Navigating away dismisses the keyboard. Returning retains the stored range without automatically focusing. focus_editor_without_repositioning explicitly resumes editing at that stored range using a non-positioning focus action.",
    "Every expected state gives the full underlying document and stored range even when the editor is offscreen. No unlisted content mutation, focus jump, language switch, alert or error is allowed."
  ],
  "limitations": [
    "Authored solely from the task brief and AGENTS.md; implementation, product screenshots, prior audit cases and candidate behavior were not inspected.",
    "Semantic UI bindings and navigation/focus expectations are proposed acceptance contracts, not claims about existing controls. A missing control or different intended focus policy needs adjudication after unsealing.",
    "No device interaction, native tests, builds, product edits, push or deployment were performed. Static artifact integrity checks do not establish product behavior.",
    "The six small cases do not cover dictation, IME composition, accessibility, orientation, persistence across app termination or locale-dependent keyboard layouts."
  ],
