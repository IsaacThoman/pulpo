        {
          "op": "reach",
          "target": "one-handed-setting",
          "direction": "up"
        },
        {
          "op": "tap",
          "target": "one-handed-setting"
        },
        {
          "op": "choose",
          "label": "Left"
        },
        {
          "op": "expectLabel",
          "target": "one-handed-setting",
          "contains": "Left"
        },
        {
          "op": "relaunch"
        },
        {
          "op": "expectScreen",
          "title": "Keyboard"
        },
        {
          "op": "reach",
          "target": "typing-language",
          "direction": "up"
        },
        {
          "op": "expectLabel",
          "target": "typing-language",
          "contains": "English"
        },
        {
          "op": "reach",
          "target": "one-handed-setting",
          "direction": "up"
        },
        {
          "op": "expectLabel",
          "target": "one-handed-setting",
          "contains": "Left"
        }
      ]
