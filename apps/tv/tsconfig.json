{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "../mobile/src/*"
      ],
      "@tv/*": [
        "./src/*"
      ],
      "react-native": [
        "./node_modules/react-native"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "ios",
    "android"
  ]
}
