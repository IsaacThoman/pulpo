# Copied to ~/.config/pulpo/local-preview.env by `npm run local:preview:init`.
# Replace every replace-* value before resetting the local preview stack.
NODE_ENV=development
PUBLIC_URL=http://localhost:8080
POSTGRES_USER=pulpo
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DATABASE=pulpo
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
ALLOW_ANY_LOCALHOST_PORT=true

WORKSPACE_CONTROLLER_URL=https://replace-with-your-controller.example.com
WORKSPACE_CONTROLLER_TOKEN=replace-with-your-preview-controller-token
PULPO_INSTANCE_ID=local-preview
PULPO_BOOTSTRAP_PRESET=ci-preview
PULPO_PREVIEW_ADMIN_EMAIL=preview@example.com
PULPO_PREVIEW_ADMIN_PASSWORD=replace-with-a-local-preview-password
PULPO_PREVIEW_PROVIDER_API_KEY=replace-with-your-preview-provider-key
PULPO_PREVIEW_WORKSPACE_IMAGE_DIGEST=replace-with-ghcr-image-at-sha256-digest

STORAGE_DRIVER=s3
STORAGE_LOCAL_PATH=/app/data/objects
S3_ENDPOINT=http://seaweed-s3:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=pulpo
S3_ACCESS_KEY_ID=pulpo
S3_SECRET_ACCESS_KEY=replace-with-a-local-storage-secret
S3_FORCE_PATH_STYLE=true
S3_CONFIGURE_CORS=true
