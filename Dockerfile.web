FROM node:22-alpine AS build
ARG NODE_ENV
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/server/package.json apps/server/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/client-core/package.json packages/client-core/package.json
COPY packages/workspace-controller/package.json packages/workspace-controller/package.json
COPY packages/workspace-daemon/package.json packages/workspace-daemon/package.json
# Build tooling is a dev dependency. Install it even when a platform injects
# NODE_ENV=production as a build argument.
RUN npm ci --include=dev
COPY . .
RUN npm run build:web

FROM nginx:1.29-alpine AS production-web
COPY deploy/nginx-static.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=6 CMD wget -q --spider http://127.0.0.1/ready || exit 1

FROM nginx:1.29-alpine AS default
COPY deploy/nginx.conf /etc/nginx/templates/default.conf.template
COPY --chmod=755 deploy/15-preview-service-host.envsh /docker-entrypoint.d/15-preview-service-host.envsh
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
